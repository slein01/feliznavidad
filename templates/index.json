        "rv4": { "type": "review", "settings": { "name": "Danny Hulsink", "date": "11 maanden geleden op Google", "rating": 5, "text": "Super origineel en stevig gemaakt — de astronaut zweeft nu vrolijk tussen de lichtjes van de boom.", "source": "via Google", "avatar_color": "#D9722B" } }
