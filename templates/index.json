        "rv1": { "type": "review", "settings": { "name": "Tim", "date": "9 maanden geleden op Google", "rating": 5, "text": "Top kerststukje voor mijn vriendin! Zeker een aanrader.", "source": "via Google", "avatar_color": "#5B4B8A" } },
