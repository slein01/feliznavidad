{%- liquid
  assign threshold = section.settings.threshold | times: 100
  assign remaining = threshold | minus: cart.total_price
  assign pct = 0
  if threshold > 0
    assign pct = cart.total_price | times: 1.0 | divided_by: threshold | times: 100 | round
  endif
  if pct > 100
    assign pct = 100
  endif
-%}
{%- if cart != empty -%}
  <div class="fn-shipbar page-width">
    {%- if remaining > 0 -%}
      <p class="fn-shipbar__msg">Nog <strong>{{ remaining | money }}</strong> tot gratis verzending</p>
    {%- else -%}
      <p class="fn-shipbar__msg fn-shipbar__msg--done">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 6"/></svg>
        Je hebt gratis verzending!
      </p>
    {%- endif -%}
    <div class="fn-shipbar__track"><div class="fn-shipbar__fill" style="width: {{ pct }}%"></div></div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "FN — Verzendbalk",
  "settings": [
    { "type": "number", "id": "threshold", "label": "Drempel voor gratis verzending (€)", "default": 25 }
  ],
  "presets": [{ "name": "FN — Verzendbalk" }]
}
{% endschema %}
