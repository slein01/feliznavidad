<nav class="fn-crumbs page-width" aria-label="Kruimelpad">
  <a href="{{ routes.root_url }}">Home</a>
  {%- if template contains 'collection' and collection -%}
    <span aria-hidden="true">/</span><span>{{ collection.title }}</span>
  {%- elsif template contains 'product' and product -%}
    {%- if collection -%}
      <span aria-hidden="true">/</span><a href="{{ collection.url }}">{{ collection.title }}</a>
    {%- endif -%}
    <span aria-hidden="true">/</span><span>{{ product.title }}</span>
  {%- elsif template contains 'page' and page -%}
    <span aria-hidden="true">/</span><span>{{ page.title }}</span>
  {%- elsif template contains 'article' and article -%}
    {%- if blog -%}<span aria-hidden="true">/</span><a href="{{ blog.url }}">{{ blog.title }}</a>{%- endif -%}
    <span aria-hidden="true">/</span><span>{{ article.title }}</span>
  {%- endif -%}
</nav>

{%- comment -%} BreadcrumbList structured data — voor rich snippets in Google en context voor AI-crawlers {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ routes.root_url | absolute_url | json }} }
    {%- if template contains 'collection' and collection -%}
      ,{ "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ collection.url | absolute_url | json }} }
    {%- elsif template contains 'product' and product -%}
      {%- if collection -%}
        ,{ "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ collection.url | absolute_url | json }} }
        ,{ "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ product.url | absolute_url | json }} }
      {%- else -%}
        ,{ "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ product.url | absolute_url | json }} }
      {%- endif -%}
    {%- elsif template contains 'page' and page -%}
      ,{ "@type": "ListItem", "position": 2, "name": {{ page.title | json }}, "item": {{ page.url | absolute_url | json }} }
    {%- elsif template contains 'article' and article -%}
      {%- if blog -%}
        ,{ "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ blog.url | absolute_url | json }} }
        ,{ "@type": "ListItem", "position": 3, "name": {{ article.title | json }}, "item": {{ article.url | absolute_url | json }} }
      {%- else -%}
        ,{ "@type": "ListItem", "position": 2, "name": {{ article.title | json }}, "item": {{ article.url | absolute_url | json }} }
      {%- endif -%}
    {%- endif -%}
  ]
}
</script>

{% schema %}
{
  "name": "FN — Kruimelpad",
  "settings": [],
  "presets": [{ "name": "FN — Kruimelpad" }]
}
{% endschema %}
