<div class="fn-statement page-width">
  <div class="fn-statement__copy">
    {%- if section.settings.eyebrow != blank -%}
      <p class="fn-statement__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="fn-statement__title">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <p class="fn-statement__text">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="button button--primary">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>

  <div class="fn-statement__collage">
    {%- assign shown = 0 -%}
    {%- for product in section.settings.collection.products limit: 6 -%}
      {%- if product.featured_image and shown < 4 -%}
        {%- assign shown = shown | plus: 1 -%}
        <div class="fn-statement__tile fn-statement__tile--{{ shown }}">
          {{ product.featured_image | image_url: width: 500 | image_tag: widths: '250,380,500', sizes: '(max-width: 749px) 44vw, 22rem', alt: product.title }}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "FN — Statement + collage",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Waarom ornamenten" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Je kerstboom is niet compleet zonder ornamenten" },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "Van klassieke zuurstokjes tot een gewichtheffende kerstman. Combineer ze met je kerstballen, pimp je guirlande of geef ze cadeau. En je kerst wordt helemaal top." },
    { "type": "text", "id": "button_label", "label": "Knop label", "default": "Shop nu" },
    { "type": "url", "id": "button_link", "label": "Knop link" },
    { "type": "collection", "id": "collection", "label": "Foto's uit collectie", "info": "Gebruikt de eerste 4 productfoto's" }
  ],
  "presets": [{ "name": "FN — Statement + collage" }]
}
{% endschema %}
