<div class="fn-collnav page-width">
  <span class="fn-collnav__label">Categorie</span>
  {%- for block in section.blocks -%}
    {%- liquid
      assign url = block.settings.link
      if block.settings.collection != blank
        assign url = block.settings.collection.url
      endif
      assign active = false
      if block.settings.collection != blank and collection.id == block.settings.collection.id
        assign active = true
      endif
      if block.settings.collection == blank and block.settings.is_all and template contains 'collection' and collection.handle == 'all'
        assign active = true
      endif
    -%}
    <a href="{{ url | default: '#' }}" class="fn-collnav__pill{% if active %} is-active{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "FN — Collectie-nav",
  "settings": [],
  "blocks": [
    {
      "type": "link",
      "name": "Pill",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Alles" },
        { "type": "collection", "id": "collection", "label": "Collectie" },
        { "type": "url", "id": "link", "label": "Of losse link" },
        { "type": "checkbox", "id": "is_all", "label": "Is 'Alles' (actief op /collections/all)", "default": false }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "FN — Collectie-nav",
      "blocks": [
        { "type": "link", "settings": { "label": "Alles", "link": "shopify://collections/all", "is_all": true } },
        { "type": "link", "settings": { "label": "Klassiek" } },
        { "type": "link", "settings": { "label": "Grappig" } }
      ]
    }
  ]
}
{% endschema %}
