<div class="fn-trust">
  <div class="fn-trust__grid">
    {%- for block in section.blocks -%}
      <div class="fn-trust__item" {{ block.shopify_attributes }}>
        {%- case block.settings.icon -%}
          {%- when 'truck' -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>
          {%- when 'shield' -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 5-3 7-7 9-4-2-7-4-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
          {%- when 'calendar' -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
          {%- when 'gift' -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4"/><path d="M5 12v9h14v-9M12 8v13M12 8S9 3 6.5 4.5 8 8 12 8zM12 8s3-5 5.5-3.5S16 8 12 8z"/></svg>
          {%- else -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 6"/></svg>
        {%- endcase -%}
        <div>
          <strong>{{ block.settings.heading }}</strong>
          {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "FN — Trust-strip",
  "blocks": [
    {
      "type": "item",
      "name": "Punt",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icoon", "default": "truck",
          "options": [
            { "value": "truck", "label": "Vrachtwagen" },
            { "value": "shield", "label": "Schild" },
            { "value": "calendar", "label": "Kalender" },
            { "value": "gift", "label": "Cadeau" },
            { "value": "check", "label": "Vinkje" }
          ]
        },
        { "type": "text", "id": "heading", "label": "Kop", "default": "Gratis verzending vanaf €25" },
        { "type": "text", "id": "text", "label": "Tekst", "default": "Daaronder €3,95 in heel Nederland." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "FN — Trust-strip",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "heading": "Gratis verzending vanaf €25", "text": "Daaronder €3,95 in heel Nederland." } },
        { "type": "item", "settings": { "icon": "shield", "heading": "Veilig betalen", "text": "Met iDEAL, creditcard of PayPal." } },
        { "type": "item", "settings": { "icon": "calendar", "heading": "In 2–3 werkdagen in huis", "text": "Ruim op tijd voor de boom." } }
      ]
    }
  ]
}
{% endschema %}
