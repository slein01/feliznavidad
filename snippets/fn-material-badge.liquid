{%- comment -%}
  Materiaallabel op de PDP-galerij, o.b.v. producttag (hoofdletters maken niet uit):
  - tag "plastic" → "Onbreekbaar plastic" (groen)
  - tag "glas"    → "Echt glas" (pine met goud)
  Zonder een van deze tags verschijnt er geen label.
{%- endcomment -%}
{%- liquid
  assign fn_material = ''
  for t in product.tags
    assign fn_tag = t | downcase | strip
    if fn_tag == 'glas'
      assign fn_material = 'glas'
    elsif fn_tag == 'plastic' and fn_material == blank
      assign fn_material = 'plastic'
    endif
  endfor
-%}
{%- if fn_material == 'plastic' -%}
  <span class="fn-material-badge fn-material-badge--plastic">Onbreekbaar plastic</span>
{%- elsif fn_material == 'glas' -%}
  <span class="fn-material-badge fn-material-badge--glas">Echt glas</span>
{%- endif -%}
