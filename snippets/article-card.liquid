{% comment %}
  Blogkaart (FelizNavidad). Eén kaart per artikel: optionele teaserafbeelding bovenaan
  (de uitgelichte afbeelding van het artikel), daaronder label, titel, intro en "Lees verder".

  Accepts:
  - blog: {Object} Blog object
  - article: {Object} Article object
  - show_image: {Boolean} Toon de uitgelichte afbeelding als teaser (standaard: ja)
  - show_date: {Boolean} Toon de publicatiedatum
  - show_author: {Boolean} Toon de auteur
  - show_excerpt: {Boolean} Toon de intro/samenvatting
  - lazy_load: {Boolean} Afbeelding lazy laden. Default: true
  - media_aspect_ratio, media_height, show_badge: worden genegeerd (oude Dawn-opties)

  Usage:
  {% render 'article-card', blog: blog, article: article, show_image: section.settings.show_image %}
{% endcomment %}

{%- if article and article != empty -%}
  {{ 'fn-blog.css' | asset_url | stylesheet_tag }}
  {%- liquid
    assign with_image = false
    if article.image and show_image != false
      assign with_image = true
    endif
  -%}
  <div class="article-card-wrapper fn-acard-wrap">
    <article
      class="fn-acard{% if with_image %} fn-acard--media{% else %} fn-acard--text{% endif %}"
      aria-labelledby="ArticleCard-{{ article.id }}"
    >
      {%- if with_image -%}
        <div class="fn-acard__media">
          <img
            srcset="
              {%- if article.image.width >= 360 -%}{{ article.image | image_url: width: 360 }} 360w,{%- endif -%}
              {%- if article.image.width >= 533 -%}{{ article.image | image_url: width: 533 }} 533w,{%- endif -%}
              {%- if article.image.width >= 720 -%}{{ article.image | image_url: width: 720 }} 720w,{%- endif -%}
              {%- if article.image.width >= 1000 -%}{{ article.image | image_url: width: 1000 }} 1000w,{%- endif -%}
              {{ article.image | image_url }} {{ article.image.width }}w
            "
            src="{{ article.image | image_url: width: 720 }}"
            sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc((100vw - 130px) / 2), calc(100vw - 30px)"
            alt="{{ article.image.alt | default: article.title | escape }}"
            {% unless lazy_load == false %}
              loading="lazy"
            {% endunless %}
            width="{{ article.image.width }}"
            height="{{ article.image.height }}"
          >
        </div>
      {%- endif -%}

      <div class="fn-acard__body">
        <span class="fn-acard__label">Inspiratie</span>
        <h3 class="fn-acard__title" id="ArticleCard-{{ article.id }}">
          <a href="{{ article.url }}" class="fn-acard__link">
            {{- article.title | truncate: 90 | escape -}}
          </a>
        </h3>

        {%- if show_date or show_author -%}
          <p class="fn-acard__meta">
            {%- if show_date -%}
              {{ article.published_at | time_tag: format: 'date' }}
            {%- endif -%}
            {%- if show_date and show_author %} · {% endif -%}
            {%- if show_author -%}
              <span>{{ article.author }}</span>
            {%- endif -%}
          </p>
        {%- endif -%}

        {%- if show_excerpt != false -%}
          {%- if article.excerpt.size > 0 or article.content.size > 0 -%}
            <p class="fn-acard__excerpt">
              {%- if article.excerpt.size > 0 -%}
                {{ article.excerpt | strip_html | truncatewords: 30 }}
              {%- else -%}
                {{ article.content | strip_html | truncatewords: 30 }}
              {%- endif -%}
            </p>
          {%- endif -%}
        {%- endif -%}

        <span class="fn-acard__more" aria-hidden="true">Lees verder &rarr;</span>
      </div>
    </article>
  </div>
{%- endif -%}
